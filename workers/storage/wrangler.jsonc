{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "gnhweb-storage",
  "compatibility_date": "2026-09-09",
  "main": "src/index.ts",
  "r2_buckets": [
    {
      "binding": "STORAGE",
      "bucket_name": "gnhweb-storage"
    }
  ],
  "vars": {
    "ALLOWED_ORIGIN": "https://gnhweb.vercel.app",
    "NEON_JWKS_URL": "__SET_PER_ENVIRONMENT__"
  }
}
